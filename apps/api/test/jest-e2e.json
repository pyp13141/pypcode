{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testTimeout": 30000,
  "maxWorkers": 1,
  "globalSetup": "<rootDir>/global-setup-e2e.ts",
  "setupFiles": ["<rootDir>/setup-e2e.ts"]
}
