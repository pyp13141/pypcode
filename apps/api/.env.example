# 复制为 .env 并填写真实值；生产值放 /etc/pet-neighbor/api.env（不进 Git）
NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=3001
# 数据库专用账号 petn_app；密码通过环境变量或部署平台的密钥管理注入，不要提交到仓库
DATABASE_URL=postgresql://petn_app:change_me@127.0.0.1:5432/pet_neighbor
# 文档 15.3：支付默认关闭
PAYMENT_ENABLED=false
# D-006：微信小程序凭证；留空时开发环境走 Mock 登录，生产启动失败（护栏）
WECHAT_APPID=
WECHAT_APPSECRET=
# 生产内测豁免：显式允许 Mock（拿到正式 AppID 后删除本行）
# ALLOW_WECHAT_MOCK=true
# D-008：敏感字段 AES-256-GCM 密钥（32 字节 base64，openssl rand -base64 32 生成）
SENSITIVE_ENCRYPTION_KEY=

# 邮件发送（真实验证码邮件；D-014）：配置后自动启用 SMTP 发送，未配置走 Mock（验证码打日志）
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_FROM=你的QQ号@qq.com SMTP_PASS=SMTP授权码（非QQ密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
